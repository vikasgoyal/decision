# Copy to .env and fill in your values.

# Foundry resource endpoint: HTTPS base URL, no path.
AZURE_ENDPOINT=https://<your-resource>.services.ai.azure.com

# Name of your Microsoft-Decision-1 deployment (not necessarily the model name).
DEPLOYMENT_NAME=<your-deployment-name>

# Optional: Entra ID access token. Leave unset to use your Azure CLI sign-in.
# AZURE_ENTRA_TOKEN=
